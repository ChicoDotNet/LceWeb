{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lce.example/contracts/diagnostic-definition.schema.json",
  "title": "Diagnostic definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "isActive", "name", "copy", "dimensions", "steps", "results"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "isActive": { "type": "boolean" },
    "name": { "type": "string", "minLength": 1 },
    "copy": { "$ref": "#/$defs/copy" },
    "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "results": { "type": "array", "items": { "$ref": "#/$defs/resultBand" } }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introTitle", "completionTitle"],
      "properties": {
        "introTitle": { "type": "string", "minLength": 1 },
        "introBody": { "type": ["string", "null"] },
        "completionTitle": { "type": "string", "minLength": 1 },
        "completionBody": { "type": ["string", "null"] }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "operator", "values"],
      "properties": {
        "questionId": { "$ref": "#/$defs/stableId" },
        "operator": { "enum": ["anyOf", "noneOf"] },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "visibleWhen": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }] },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "prompt", "type", "required", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "order": { "type": "integer", "minimum": 0 },
        "prompt": { "type": "string", "minLength": 1 },
        "helpText": { "type": ["string", "null"] },
        "type": { "enum": ["singleChoice", "multipleChoice", "text"] },
        "required": { "type": "boolean" },
        "minSelections": { "type": ["integer", "null"], "minimum": 0 },
        "maxSelections": { "type": ["integer", "null"], "minimum": 1 },
        "maxLength": { "type": ["integer", "null"], "minimum": 1 },
        "visibleWhen": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }] },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "label", "scores"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "order": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "scores": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "resultBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimensionId", "minScore", "label", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "dimensionId": { "$ref": "#/$defs/stableId" },
        "minScore": { "type": "integer" },
        "maxScore": { "type": ["integer", "null"] },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
