{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lce.local/contracts/lead-submission.schema.json",
  "title": "LCE lead submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosticId", "definitionVersion", "contact", "answers"],
  "properties": {
    "diagnosticId": {
      "type": "string",
      "format": "uuid"
    },
    "definitionVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "phone": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["callingCode", "number"],
              "properties": {
                "callingCode": {
                  "type": "string",
                  "pattern": "^\\+[1-9]\\d{0,3}$"
                },
                "number": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 24
                }
              }
            }
          ]
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "answerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "text": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "acquisition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "utmSource": { "type": ["string", "null"], "maxLength": 256 },
        "utmMedium": { "type": ["string", "null"], "maxLength": 256 },
        "utmCampaign": { "type": ["string", "null"], "maxLength": 256 },
        "utmTerm": { "type": ["string", "null"], "maxLength": 256 },
        "utmContent": { "type": ["string", "null"], "maxLength": 256 },
        "referrer": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 },
        "pageUrl": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
      }
    },
    "website": {
      "type": ["string", "null"],
      "description": "Honeypot. Legitimate clients leave this empty."
    }
  }
}
